include ../src/

# Vulkan implicit-layer manifests for Vulkan-Loader discovery. Two
# generated jsons (out-tree and installed), each a plain in{}-substituted
# file{} with library_path computed relative to its own directory (Khronos
# rule, which keeps config.install.relocatable=true working). No custom
# recipes: update is the stock in rule, install/uninstall is the stock
# install rule.
#
# json{renderdoc_capture} (out-tree) and json{renderdoc_capture-install}
# (installed) are both consumed by librenderdoc-tests, but not by
# importing either json{} target directly: a plain, non-metadata-protocol
# import of a custom, not-installed (or, for -install, non-library) target
# type cannot cross a sys: package boundary. libs{renderdoc}'s metadata
# carries the json path instead (see ../src/buildfile, where
# libs{renderdoc} and its export.metadata live: importing a target only
# loads the buildfile where it is declared, not every buildfile that later
# adds variables to it, so it can't live here).
#
# Layer mode requires the shared library, so the generated jsons (and the
# adhoc library update they trigger) only exist when shared is being
# built.
#
in.symbol = '@'
in.mode = lax

shared = ($bin.lib != 'static')

macos = ($cxx.target.class == 'macos')
windows = ($cxx.target.class == 'windows')

# Same suffix as bin.lib.version in ../src/buildfile. Final releases are
# unversioned (upstream CMake sets no SOVERSION). Pre-releases keep the
# snapshot suffix so they cannot substitute for a final.
#
if $version.pre_release
  ver_sfx = "-$version.project_id"
else
  ver_sfx = ""

# Adjacent quotes terminate $ver_sfx. A single string like
# "librenderdoc$ver_sfx.dylib" would look up ver_sfx.dylib.
#
lib_leaf = ($macos   ? "librenderdoc$ver_sfx"".dylib" : \
            $windows ? "renderdoc$ver_sfx"".dll"      : \
                       "librenderdoc$ver_sfx"".so")

# Declarations stay unconditional so dist produces the same target graph
# regardless of $shared. Only default target-set participation is
# conditional, via `include` below. The template is renderdoc.json, not
# renderdoc.json.in, hence the trailing dot.
#
json{renderdoc_capture}: ../src/driver/vulkan/in{renderdoc.json.}
json{renderdoc_capture}: ../src/libs{renderdoc}: include = adhoc
json{renderdoc_capture}:
{
  VULKAN_LAYER_NAME = VK_LAYER_RENDERDOC_Capture
  VULKAN_ENABLE_VAR = ENABLE_VULKAN_RENDERDOC_CAPTURE
  RENDERDOC_VERSION_MAJOR = $version.major
  RENDERDOC_VERSION_MINOR = $version.minor
  VULKAN_LAYER_MODULE_PATH = $posix_string($relative([path] $out_root/src/$lib_leaf, $out_base))
  install = false
  dist = false
}

./: json{renderdoc_capture}: include = $shared

# The library, resolved relative to etc/vulkan/implicit_layer.d/ (not as
# an absolute path: the two-argument $install.resolve() form is required
# for config.install.relocatable=true). A DLL installs to bin/, a shared
# object to lib/. Without config.install.root nothing can be installed,
# so the target only exists when it is set.
#
if ($install.root != [null])
{
  layer_etcdir = $install.resolve([dir_path] etc/vulkan/implicit_layer.d/, [dir_path])
  layer_libdir = $install.resolve(($windows ? $install.bin : $install.lib), $layer_etcdir)

  json{renderdoc_capture-install}: ../src/driver/vulkan/in{renderdoc.json.}
  json{renderdoc_capture-install}: ../src/libs{renderdoc}: include = adhoc
  json{renderdoc_capture-install}:
  {
    VULKAN_LAYER_NAME = VK_LAYER_RENDERDOC_Capture
    VULKAN_ENABLE_VAR = ENABLE_VULKAN_RENDERDOC_CAPTURE
    RENDERDOC_VERSION_MAJOR = $version.major
    RENDERDOC_VERSION_MINOR = $version.minor
    VULKAN_LAYER_MODULE_PATH = $posix_string([path] $layer_libdir/$lib_leaf)
    install = etc/vulkan/implicit_layer.d/renderdoc_capture.json
    dist = false
  }

  ./: json{renderdoc_capture-install}: include = $shared
}
