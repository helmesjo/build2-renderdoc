intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# Public in-application API is the sibling binless package.
#
import intf_libs = librenderdoc-app%lib{renderdoc-app}

import impl_libs += libvulkan-headers%lib{vulkan-headers} \
                    libzstd%lib{zstd} \
                    pugixml%lib{pugixml} \
                    libminiz%lib{miniz} \
                    libtinyexr%lib{tinyexr} \
                    liblz4%lib{lz4} \
                    stb_image%lib{stb_image} \
                    stb_image_write%lib{stb_image_write} \
                    stb_image_resize2%lib{stb_image_resize2} \
                    stb_truetype%lib{stb_truetype} \
                    libjpeg-compressor%lib{jpeg-compressor} \
                    libtinyfiledialogs%lib{tinyfiledialogs} \
                    libhalf%lib{half} \
                    libcmp-core%lib{CMP_Core} \
                    libglslang%lib{glslang} \
                    libglslang%lib{glslang-default-resource-limits} \
                    libgpuperfapi-headers%lib{gpuperfapi-headers} \
                    libamddxgsa%lib{amddxgsa} \
                    libdevdriverapi-headers%lib{devdriverapi-headers}

# MSVC/clang-cl only. MinGW uses sysroot D3D headers and is CI-excluded.
if ($cxx.target.class == 'windows' && $cxx.target.system != 'mingw32')
  import impl_libs += libdirectx-headers%liba{directx-headers} \
                      libags%lib{ags} \
                      libamddxext%lib{amddxext} \
                      libnvapi%lib{nvapi} \
                      libmetrics-discovery-headers%lib{metrics-discovery-headers}

if ($cxx.target.class == 'macos')
  import impl_libs += libmetal-cpp%lib{metal-cpp}

if ($cxx.target.class == 'linux')
  import impl_libs += libplthook%lib{plthook}

# Nsight Perf SDK headers for the NVIDIA counters. libnvperf is x86_64 only.
#
if ($cxx.target.cpu == 'x86_64' && \
    ($cxx.target.class == 'linux' || $cxx.target.class == 'windows'))
  import impl_libs += libnvperf%lib{nvperf}

out_pfx = [dir_path] $out_root/src/
src_pfx = [dir_path] $src_root/src/

macos = ($cxx.target.class == 'macos')
linux = ($cxx.target.class == 'linux')
windows = ($cxx.target.class == 'windows')
posix = ($cxx.target.class != 'windows')

./: lib{renderdoc}

# Core sources. Catch v1 unit-test TUs stay out of the lib.
#
lib{renderdoc}: {hxx txx cxx}{api/**} \
                {hxx txx cxx}{common/** -**_tests} \
                {hxx txx cxx}{core/** -**_tests} \
                {hxx txx cxx}{android/**} \
                {hxx txx cxx}{hooks/**} \
                {hxx txx cxx}{maths/**} \
                {hxx cxx}{os/os_specific} \
                {hxx txx cxx}{replay/** -**_tests} \
                {hxx txx cxx}{serialise/** -**_tests} \
                {hxx cxx}{shaders/**} \
                {hxx cxx}{strings/**} \
                data/{hxx}{embedded_files glsl_shaders} \
                3rdparty/md5/{hxx c}{*} \
                3rdparty/superluminal/{hxx cxx}{*} \
                3rdparty/tinyexr/cxx{tinyexr_impl} \
                3rdparty/stb/c{stb_impl} \
                3rdparty/catch/cxx{catch_stub}

lib{renderdoc}: 3rdparty/half/file{half.hpp}: include = adhoc
lib{renderdoc}: 3rdparty/compressonator/hxx{CMP_Core}: include = adhoc
lib{renderdoc}: 3rdparty/glslang/glslang/Public/hxx{ShaderLang ResourceLimits}: include = adhoc
lib{renderdoc}: 3rdparty/glslang/glslang/Include/hxx{Types}: include = adhoc
lib{renderdoc}: 3rdparty/zstd/hxx{zstd}: include = adhoc
lib{renderdoc}: 3rdparty/miniz/hxx{miniz}: include = adhoc
lib{renderdoc}: 3rdparty/tinyexr/hxx{tinyexr}: include = adhoc
lib{renderdoc}: 3rdparty/lz4/hxx{lz4}: include = adhoc
lib{renderdoc}: 3rdparty/stb/hxx{stb_image stb_image_write stb_image_resize2 stb_truetype}: \
  include = adhoc
lib{renderdoc}: compat/3rdparty/pugixml/file{pugixml.hpp}: include = adhoc
lib{renderdoc}: data/cxx{glsl_shaders}: \
  include = ($config.librenderdoc.vulkan || $config.librenderdoc.gl)

# POSIX / Win32 OS backends.
#
lib{renderdoc}: os/posix/apple/{cxx mm}{*}: include = $macos
lib{renderdoc}: os/posix/cxx{posix_network \
                             posix_process \
                             posix_stringio \
                             posix_threading}: \
  include = $posix
lib{renderdoc}: os/posix/hxx{posix_network posix_specific}: include = $posix
lib{renderdoc}: os/posix/linux/cxx{*}: include = $linux
lib{renderdoc}: os/win32/{hxx cxx}{*}: include = $windows
lib{renderdoc}: 3rdparty/plthook/hxx{plthook}: include = adhoc

# Vulkan driver.
#
lib{renderdoc}: driver/vulkan/{hxx txx cxx}{** \
                      -**_tests \
                      -vk_android -vk_layer_android \
                      -vk_win32 -vk_linux -vk_apple -vk_posix}: \
  include = $config.librenderdoc.vulkan
lib{renderdoc}: driver/vulkan/cxx{vk_posix}: \
  include = ($config.librenderdoc.vulkan && $posix)
lib{renderdoc}: driver/vulkan/cxx{vk_linux}: \
  include = ($config.librenderdoc.vulkan && $linux)
lib{renderdoc}: driver/vulkan/cxx{vk_apple}: \
  include = ($config.librenderdoc.vulkan && $macos)
lib{renderdoc}: driver/vulkan/mm{vk_apple_helpers}: \
  include = ($config.librenderdoc.vulkan && $macos)
lib{renderdoc}: driver/vulkan/cxx{vk_win32}: \
  include = ($config.librenderdoc.vulkan && $windows)
lib{renderdoc}: driver/vulkan/official/hxx{*}: \
  include = ($config.librenderdoc.vulkan ? adhoc : false)

# SPIR-V (packaged libglslang).
#
lib{renderdoc}: driver/shaders/spirv/{hxx cxx}{**}: \
  include = ($config.librenderdoc.vulkan || $config.librenderdoc.gl)

# AMD IHV is unconditional. NVIDIA Aftermath follows GL/Vulkan. Extra NV
# counter TUs match CMake (not Android, not Apple).
#
lib{renderdoc}: driver/ihv/amd/{hxx cxx}{amd_counters amd_isa amd_isa_devices amd_rgp} \
                driver/ihv/amd/hxx{official/RGP/DevDriverAPI}
lib{renderdoc}: driver/ihv/amd/cxx{amd_isa_posix}: include = $posix
lib{renderdoc}: driver/ihv/amd/cxx{amd_isa_win32 amd_hooks}: include = $windows
lib{renderdoc}: driver/ihv/amd/{hxx cxx}{ags_wrapper}: include = $windows
lib{renderdoc}: driver/ihv/nv/{hxx cxx}{nv_aftermath}: \
  include = ($config.librenderdoc.vulkan || $config.librenderdoc.gl)
lib{renderdoc}: driver/ihv/nv/{hxx cxx}{nv_counter_enumerator}: include = $linux
lib{renderdoc}: driver/ihv/nv/{hxx cxx}{nv_vk_counters}: \
  include = ($linux && $config.librenderdoc.vulkan)
lib{renderdoc}: driver/ihv/nv/{hxx cxx}{nv_gl_counters}: \
  include = ($linux && $config.librenderdoc.gl)
lib{renderdoc}: driver/ihv/intel/{hxx cxx}{intel_gl_counters}: \
  include = $config.librenderdoc.gl
lib{renderdoc}: driver/ihv/arm/hxx{arm_counters} \
                driver/ihv/arm/cxx{arm_counters_stub}: \
  include = $config.librenderdoc.gl

# Metal (macOS). official/metal-cpp.h is a local shim over packaged
# libmetal-cpp (enum remap plus Foundation helpers missing in 381).
#
lib{renderdoc}: driver/metal/{hxx cxx mm}{** -official/metal-cpp}: \
  include = $config.librenderdoc.metal
lib{renderdoc}: driver/metal/official/hxx{metal-cpp}: \
  include = ($config.librenderdoc.metal ? adhoc : false)

# OpenGL. Apple uses CGL, other POSIX uses GLX, Windows uses WGL.
# GLES/EGL stay off here. Headers stay in the glob so dist ships
# apple_gl_hook_defs.h (included by gl_hooks.cpp on every platform).
# precompiled.cpp is MSVC PCH only.
#
lib{renderdoc}: driver/gl/{hxx}{**}: include = $config.librenderdoc.gl
lib{renderdoc}: driver/gl/{cxx}{** \
                    -apple_gl_hook_defs -cgl_platform -cgl_hooks \
                    -glx_platform -glx_hooks -glx_fake_vk_hooks \
                    -egl_platform -egl_hooks \
                    -wgl_platform -wgl_hooks \
                    -precompiled}: \
  include = $config.librenderdoc.gl
lib{renderdoc}: driver/gl/hxx{apple_gl_hook_defs} \
                driver/gl/cxx{apple_gl_hook_defs cgl_platform cgl_hooks} \
                driver/gl/mm{cgl_platform_helpers}: \
  include = ($config.librenderdoc.gl && $macos)
lib{renderdoc}: driver/gl/cxx{glx_platform glx_hooks glx_fake_vk_hooks}: \
  include = ($config.librenderdoc.gl && $linux)
lib{renderdoc}: driver/gl/cxx{wgl_platform wgl_hooks}: \
  include = ($config.librenderdoc.gl && $windows)

# D3D11 / D3D12 / DXGI (Windows).
#
lib{renderdoc}: driver/d3d11/{hxx cxx}{**} \
                driver/d3d12/{hxx cxx}{**} \
                driver/dxgi/{hxx cxx}{**} \
                driver/dx/{hxx}{**} \
                driver/shaders/dxbc/{hxx cxx}{**} \
                driver/shaders/dxil/{hxx cxx}{**}: \
  include = ($config.librenderdoc.d3d11 || $config.librenderdoc.d3d12)

# include-bin: host tool that turns data files into C arrays. Not installed.
# Declared here (package src/), not under the 3rdparty/include-bin symlink.
#
exe{include-bin}: cxx{3rdparty/include-bin/main}
exe{include-bin}:
{
  dist = false
  install = false
  test = false
}

# dist = false on the exe would otherwise drop main.cpp from the archive.
#
lib{renderdoc}: cxx{3rdparty/include-bin/main}: include = adhoc

embed_files = \
  data/sourcecodepro.ttf \
  data/glsl/blit.vert \
  data/glsl/checkerboard.frag \
  data/glsl/texdisplay.frag \
  data/glsl/gltext.vert \
  data/glsl/gltext.frag \
  data/glsl/vktext.vert \
  data/glsl/vktext.frag \
  data/glsl/fixedcol.frag \
  data/glsl/mesh.vert \
  data/glsl/mesh.geom \
  data/glsl/mesh.frag \
  data/glsl/trisize.geom \
  data/glsl/trisize.frag \
  data/glsl/minmaxtile.comp \
  data/glsl/minmaxresult.comp \
  data/glsl/histogram.comp \
  data/glsl/glsl_globals.h \
  data/glsl/glsl_ubos.h \
  data/glsl/gl_texsample.h \
  data/glsl/vk_texsample.h \
  data/glsl/quadresolve.frag \
  data/glsl/quadwrite.frag \
  data/glsl/mesh.comp \
  data/glsl/array2ms.comp \
  data/glsl/ms2array.comp \
  data/glsl/deptharr2ms.frag \
  data/glsl/depthms2arr.frag \
  data/glsl/gles_texsample.h \
  data/glsl/pixelhistory_mscopy.comp \
  data/glsl/pixelhistory_mscopy_depth.comp \
  data/glsl/pixelhistory_primid.frag \
  data/glsl/shaderdebug_sample.vert \
  data/glsl/texremap.frag \
  data/glsl/discard.frag \
  data/glsl/vk_ms2buffer.comp \
  data/glsl/vk_depthms2buffer.comp \
  data/glsl/vk_buffer2ms.comp \
  data/glsl/vk_depthbuf2ms.frag \
  data/glsl/depth_copy.frag \
  data/glsl/depth_copyms.frag \
  data/glsl/debug_math.comp \
  data/glsl/debug_sample.frag \
  data/hlsl/quadswizzle.hlsl

for f: $embed_files
{
  n = $regex.replace($f, '[^A-Za-z0-9]', '_')

  c{$n}: file{$f} exe{include-bin}
  {{
    diag include-bin $>
    rel = $posix_string($relative($path($<[0]), $src_base))
    env -c $src_base -- $path($<[1]) $rel $path($>)
  }}

  lib{renderdoc}: c{$n}
}

# Same json template as the in{} layer manifests. Use the in{} target so
# dist ships the file once.
#
c{driver_vulkan_renderdoc_json}: driver/vulkan/in{renderdoc.json.} exe{include-bin}
{{
  diag include-bin $>
  rel = $posix_string($relative($path($<[0]), $src_base))
  env -c $src_base -- $path($<[1]) $rel $path($>)
}}
lib{renderdoc}: c{driver_vulkan_renderdoc_json}

# Headers included from sources but not matched by the compiled hxx globs
# (data/glsl extras, IHV vendor trees). Dist needs them.
#
lib{renderdoc}: data/hxx{resource} \
                data/glsl/hxx{glsl_ubos_cpp} \
                data/hlsl/hxx{hlsl_texsample hlsl_custom_prefix hlsl_cbuffers}: \
  include = adhoc
lib{renderdoc}: driver/ihv/amd/hxx{official/**}: include = adhoc
lib{renderdoc}: driver/ihv/nv/hxx{official/**}: include = adhoc
lib{renderdoc}: driver/ihv/intel/hxx{official/**}: include = adhoc

# Libraries after every source so that each object precedes them on the
# link line (GCC on Debian and Ubuntu links with --as-needed).
#
lib{renderdoc}: $impl_libs $intf_libs

# posix_libentry last so library_loaded() runs after other static
# constructors. Upstream builds this file as renderdoc_libentry and
# appends that archive. Shared links the object directly. Static
# consumers link the one-file archive whole (-force_load on Apple,
# --whole-archive on ELF). Prerequisite of liba{} only, so install
# does not hit a for-install flavour clash.
#
libs{renderdoc}: os/posix/cxx{posix_libentry}: include = $posix

liba{renderdoc_libentry}: os/posix/cxx{posix_libentry}
liba{renderdoc_libentry}: bin.whole = true

liba{renderdoc}: liba{renderdoc_libentry}: include = $posix

# GIT_COMMIT_HASH is a compile define, not a checked-in hash.
#
obj{replay/version}: \
  cxx.poptions += "-DGIT_COMMIT_HASH=\"$version.project_id\""

# Build options.
#
# -I.../3rdparty resolves upstream's "lz4/lz4.h" style includes to the
# shims there. -I.../compat resolves "3rdparty/pugixml/pugixml.hpp" (see
# the shim for why it is not under 3rdparty/). Private paths only, never
# export.
#
cc.poptions =+ "-I$out_pfx" "-I$src_pfx/3rdparty" "-I$src_pfx" \
               "-I$src_pfx/compat"

cc.poptions += -DRDOC_BASE_NAME=renderdoc -DRENDERDOC_EXPORTS -DRELEASE \
               -DRENDERDOC_VULKAN_JSON_SUFFIX=

if $config.librenderdoc.vulkan
  cc.poptions += -DRENDERDOC_SUPPORT_VULKAN -DVK_ENABLE_BETA_EXTENSIONS

if $config.librenderdoc.gl
  cc.poptions += -DRENDERDOC_SUPPORT_GL

if $config.librenderdoc.metal
  cc.poptions += -DRENDERDOC_SUPPORT_METAL

# Xlib, XCB, and Wayland follow the headers on the compiler search path.
# Wayland also needs linux/input.h (key codes in linux_stringio.cpp).
# The macros and libraries are applied only for a Linux target.
#
have_x11_xlib_h = [bool] ($c.find_system_header("X11/Xlib.h") != [null])
have_xcb_xcb_h = [bool] ($c.find_system_header("xcb/xcb.h") != [null])
have_wayland = [bool] ($c.find_system_header("wayland-client.h") != [null] && \
                       $c.find_system_header("linux/input.h") != [null])

switch $cxx.target.class
{
  case 'macos'
    cc.poptions += -DRENDERDOC_PLATFORM_APPLE
  case 'linux'
  {
    cc.poptions += -DRENDERDOC_PLATFORM_LINUX

    if $have_x11_xlib_h
      cc.poptions += -DRENDERDOC_WINDOWING_XLIB

    if $have_xcb_xcb_h
      cc.poptions += -DRENDERDOC_WINDOWING_XCB

    if $have_wayland
      cc.poptions += -DRENDERDOC_WINDOWING_WAYLAND
  }
  case 'windows'
    cc.poptions += -DRENDERDOC_PLATFORM_WIN32
}

# VK_USE_PLATFORM_* are directory-scoped in upstream
# driver/vulkan/CMakeLists.txt. Xlib's Bool macro must stay out of other
# TUs. Linux also defines WIN32 so Win32 captures still type-check. The
# official/vulkan.h shim stubs the Win32 and Xrandr types.
#
vulkan_poptions =

if $linux
{
  vulkan_poptions += -DVK_USE_PLATFORM_WIN32_KHR

  if $have_x11_xlib_h
    vulkan_poptions += -DVK_USE_PLATFORM_XLIB_KHR \
                       -DVK_USE_PLATFORM_XLIB_XRANDR_EXT

  if $have_xcb_xcb_h
    vulkan_poptions += -DVK_USE_PLATFORM_XCB_KHR

  if $have_wayland
    vulkan_poptions += -DVK_USE_PLATFORM_WAYLAND_KHR
}

if $macos
  vulkan_poptions += -DVK_USE_PLATFORM_MACOS_MVK -DVK_USE_PLATFORM_METAL_EXT

if $windows
  vulkan_poptions += -DVK_USE_PLATFORM_WIN32_KHR

obj{driver/vulkan/**}: cxx.poptions += $vulkan_poptions

# Match upstream: -fno-strict-aliasing, hidden visibility. No -Wall / -Werror.
#
# Upstream also passes the shared -Wno-* flags below for GCC and Clang.
# -Wswitch is not in that set. The Vulkan headers add enumerators that the
# driver switches do not handle, so disable it here as well. The flags in
# the GCC arm follow upstream's version cutoffs.
#
if ($cxx.class == 'gcc')
{
  cc.coptions += -fno-strict-aliasing -fvisibility=hidden
  cxx.coptions += -fvisibility-inlines-hidden

  cxx.coptions += -Wno-unused-variable -Wno-unused-parameter \
                  -Wno-unused-result -Wno-type-limits \
                  -Wno-missing-field-initializers -Wno-unknown-pragmas \
                  -Wno-reorder -Wno-switch

  if ($cxx.id == 'gcc')
  {
    cxx.coptions += -Wno-unused-but-set-variable -Wno-maybe-uninitialized \
                    -Wno-class-memaccess

    # False positives from inlining (GCC bug 103993).
    #
    if ($cxx.version > 11.0.9)
      cxx.coptions += -Wno-mismatched-new-delete

    if ($cxx.version > 11.9)
      cxx.coptions += -Wno-unused-value

    if ($cxx.version > 13.9)
      cxx.coptions += -Wno-cast-user-defined
  }
}

# rdcstr.h declares operator"" _lit. Clang warns about that space (CWG2521)
# from every TU that includes the header. GCC warns only in C++23.
# Apple Clang's id is clang-apple, so match the type.
#
if ($cxx.id.type == 'clang')
  cxx.coptions += -Wno-deprecated-literal-operator

# System libraries.
#
switch $cxx.target.class
{
  case 'macos'
  {
    cxx.libs += -framework Cocoa -framework QuartzCore -liconv -ldl -pthread
    if $config.librenderdoc.metal
      cxx.libs += -framework Metal
    if $config.librenderdoc.gl
      cxx.libs += -framework OpenGL
  }
  case 'linux'
  {
    cxx.libs += -ldl -lm -lrt -pthread

    if $have_x11_xlib_h
      cxx.libs += -lX11

    if $have_xcb_xcb_h
      cxx.libs += -lxcb -lxcb-keysyms

    if $have_wayland
      cxx.libs += -lwayland-client
  }
  case 'windows'
  {
    if ($cxx.target.system == 'mingw32')
      cxx.libs += -ld3d11 -ldxgi -luser32 -lgdi32
    else
      cxx.libs += d3d11.lib dxgi.lib user32.lib gdi32.lib
  }
}

libs{renderdoc}: file{renderdoc.version}: include = adhoc

if $linux
  libs{renderdoc}: cxx.loptions += \
    "-Wl,--undefined,force_include_libentry" \
    "-Wl,--version-script,$src_base/renderdoc.version" \
    "-Wl,--no-undefined"

# Vulkan capture-layer manifest path, for librenderdoc-tests/vulkan-layer
# (see ../layer/buildfile, where the actual json{} targets and their
# install location are declared): the build-tree json, or the installed
# json when written to the installed pkg-config file. Piggybacked here, on
# libs{renderdoc}'s own export.metadata, rather than on either json{}
# target directly: importing a target only loads the buildfile where it
# is declared, not every buildfile that later adds variables to it, so
# this has to live wherever the consumer's import actually resolves to.
#
libs{renderdoc}:
{
  export.metadata = 1 librenderdoc

  librenderdoc.layer_json = [path] $out_root/layer/renderdoc_capture.json
  librenderdoc.layer_json.for_install = ($install.root != [null] \
    ? [path] $install.resolve([dir_path] etc/vulkan/implicit_layer.d/, [dir_path])/renderdoc_capture.json \
    : [path])
}

# Export options. Consumers include <renderdoc_app.h> via librenderdoc-app.
#
lib{renderdoc}:
{
  cxx.export.libs = $intf_libs
}

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
# A final release uses unversioned names matching upstream CMake
# (no SOVERSION): librenderdoc.so, librenderdoc.dylib, renderdoc.dll.
# The in-application API looks up those names with GetModuleHandle
# or dlopen(..., RTLD_NOLOAD).
#
if $version.pre_release
  lib{renderdoc}: bin.lib.version = "-$version.project_id"

# Don't install private headers. The public in-application API header is
# installed by librenderdoc-app.
#
{hxx ixx txx}{*}: install = false
