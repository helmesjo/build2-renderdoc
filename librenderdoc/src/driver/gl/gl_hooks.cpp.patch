+// The dispatch table has the function pointer types of the official headers,
+// where GLenum is the plain typedef, while the hooks take the typed RDCGLenum
+// (see gl_common.h). Call through a pointer with the hook's argument types and
+// convert the result to what the hook returns.
+template <typename R>
+struct UninitResult
+{
+  R value;
+
+  template <typename T>
+  operator T() const
+  {
+    return (T)value;
+  }
+};
+
+template <typename R, typename... P>
+struct UninitCaller
+{
+  R(APIENTRY *function)(P...);
+
+  template <typename... A>
+  auto operator()(A... args) const
+  {
+    auto real = (R(APIENTRY *)(A...))function;
+
+    if constexpr(std::is_void<R>::value)
+      return real(args...);
+    else
+      return UninitResult<R>{real(args...)};
+  }
+
+  auto fallback() const
+  {
+    if constexpr(std::is_void<R>::value)
+      return;
+    else
+      return UninitResult<R>{default_ret<R>()};
+  }
+};
+
+template <typename R, typename... P>
+UninitCaller<R, P...> UninitCall(R(APIENTRY *function)(P...))
+{
+  return {function};
+}
+
 // on windows we can be injected and not ready to capture when we intercept a GL call. If that
 // happens we need to skip and call the real function
 
