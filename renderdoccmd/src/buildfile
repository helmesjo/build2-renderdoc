import libs = librenderdoc%lib{renderdoc}
import libs += libcmdline%lib{cmdline}

exe{renderdoccmd}: {hxx cxx}{renderdoccmd} $libs testscript
exe{renderdoccmd}: cxx{renderdoccmd_linux}: include = ($cxx.target.class == 'linux')
exe{renderdoccmd}: cxx{renderdoccmd_apple}: include = ($cxx.target.class == 'macos')
exe{renderdoccmd}: mm{apple/cocoa_window}: include = ($cxx.target.class == 'macos')
exe{renderdoccmd}: cxx{renderdoccmd_win32}: include = ($cxx.target.class == 'windows')

# API headers are included as <replay/...> and <app/renderdoc_app.h>.
# Private to this executable.
#
exe{renderdoccmd}: api/replay/hxx{*} api/app/hxx{*}:
{
  include = adhoc
  install = false
}

exe{renderdoccmd}: api/replay/file{pipestate.inl renderdoc_tostr.inl}:
{
  include = adhoc
  install = false
}

# Replay headers are the upstream api/ tree, symlinked into this package so
# archive builds do not need a sibling librenderdoc source path.
#
# PYTHON_AVAILALBE is the upstream spelling.
#
# subdir=src: sources and the api/ overlay live in src_base, not src_root.
#
cxx.poptions += "-I$out_root" "-I$src_root" "-I$out_base" "-I$src_base" \
                "-I$src_base/api" \
                -DPYTHON_AVAILALBE=0

cxx.poptions += -DRENDERDOC_SUPPORT_VULKAN

switch $cxx.target.class
{
  case 'macos'
  {
    cxx.poptions += -DRENDERDOC_PLATFORM_APPLE -DRENDERDOC_SUPPORT_METAL \
                    -DRENDERDOC_SUPPORT_GL
    cxx.libs += -framework Cocoa -framework QuartzCore
  }
  case 'linux'
  {
    cxx.poptions += -DRENDERDOC_PLATFORM_LINUX -DRENDERDOC_SUPPORT_GL

    # Xlib, XCB, and Wayland follow the headers on the compiler search
    # path, as in librenderdoc. The replay preview window needs both Xlib
    # and XCB (-lX11-xcb). Wayland is capture-only and links nothing here.
    #
    have_x11_xlib_h = [bool] ($cxx.find_system_header("X11/Xlib.h") != [null])
    have_xcb_xcb_h = [bool] ($cxx.find_system_header("xcb/xcb.h") != [null])
    have_wayland = [bool] ($cxx.find_system_header("wayland-client.h") != [null] && \
                           $cxx.find_system_header("linux/input.h") != [null])

    if $have_x11_xlib_h
    {
      cxx.poptions += -DRENDERDOC_WINDOWING_XLIB
      cxx.libs += -lX11
    }

    if $have_xcb_xcb_h
    {
      cxx.poptions += -DRENDERDOC_WINDOWING_XCB
      cxx.libs += -lxcb
    }

    if ($have_x11_xlib_h && $have_xcb_xcb_h)
      cxx.libs += -lX11-xcb

    if $have_wayland
      cxx.poptions += -DRENDERDOC_WINDOWING_WAYLAND

    cxx.loptions += "-Wl,--no-as-needed" -rdynamic
  }
  case 'windows'
    cxx.poptions += -DRENDERDOC_PLATFORM_WIN32
}
