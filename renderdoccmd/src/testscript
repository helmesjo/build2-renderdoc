: version
:
# Linux also prints the windowing systems line. Windows prints only the
# version line.
#
if ($cxx.target.class != 'windows')
{
  $* version >>~"/EOO/"
  /renderdoccmd .+ v1\.45 .*/
  /APIs supported at compile-time: .*/
  /Windowing systems supported at compile-time: .*/?

  EOO
}
else
{
  $* version >>~"/EOO/"
  /renderdoccmd .+ v1\.45 .*/

  EOO
}
